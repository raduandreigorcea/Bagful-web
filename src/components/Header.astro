---
import { site } from '../../config';
interface Props {
	tone?: 'green' | 'paper';
}
const { tone = 'paper' } = Astro.props;
---

<header class:list={['header', tone]}>
	<div class="wrap bar">
		<a href="/" class="logo" aria-label="Bagful, home">
			<img src="/icons/pwa-192.png" alt="" width="36" height="36" />
			<span>Bagful</span>
		</a>
		<nav aria-label="Main">
			<a href="/#how">How it works</a>
			<a href="/#why">Why Bagful</a>
			<a href={site.appUrl} class="pill" rel="noopener">Open the web app</a>
		</nav>
	</div>
</header>

<style>
	.header {
		position: absolute;
		inset: 0 0 auto 0;
		z-index: 20;
	}
	.green {
		color: var(--on-green);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 1.1rem;
	}
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		font-weight: 800;
		font-size: 1.25rem;
		letter-spacing: -0.03em;
	}
	.logo img {
		border-radius: 10px;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		font-weight: 600;
		font-size: var(--step--1);
	}
	nav a {
		text-decoration: none;
	}
	nav a:not(.pill):hover {
		text-decoration: underline;
		text-underline-offset: 0.3em;
	}
	.pill {
		padding: 0.55rem 1.05rem;
		border-radius: 999px;
		background: var(--cream);
		color: var(--green-ink);
		box-shadow: 0 0 0 1px var(--cream-edge);
		transition: transform 0.2s var(--ease);
	}
	.pill:hover {
		transform: translateY(-2px);
	}
	@media (max-width: 40rem) {
		nav a:not(.pill) {
			display: none;
		}
	}
</style>
