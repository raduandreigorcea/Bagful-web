---
import { site } from '../../config';
---

<header class="header">
	<div class="wrap bar">
		<a href="/" class="logo" aria-label="Bagful, home">
			<img src="/icons/pwa-192.png" alt="" width="36" height="36" />
			<span>Bagful</span>
		</a>
		<nav aria-label="Main">
			<a class="sign stop-link" href="/#how">How it works</a>
			<a class="sign stop-link" href="/#why">Why Bagful</a>
			<a class="plaque line small dl" href={site.downloadUrl} rel="noopener">Download the app</a>
			<a class="plaque small" href={site.appUrl} rel="noopener">Open the web app</a>
		</nav>
	</div>
</header>

<style>
	.header {
		position: absolute;
		inset: 0 0 auto 0;
		z-index: 20;
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 1.1rem;
	}
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		font-weight: 800;
		font-size: 1.3rem;
		letter-spacing: -0.04em;
	}
	.logo img {
		border-radius: 10px;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.stop-link {
		text-decoration: none;
		padding-block: 0.5rem;
		border-bottom: 3px solid transparent;
		transition: border-color 0.2s var(--ease);
	}
	.stop-link:hover {
		border-color: var(--route-home);
	}
	.small {
		min-height: 2.75rem;
		padding: 0.5rem 1.1rem 0.5rem 0.9rem;
		font-size: 0.92rem;
	}
	@media (max-width: 52rem) {
		.stop-link,
		.dl {
			display: none;
		}
	}
</style>
