---
import Phone from './Phone.astro';
import ListScreen from './screens/ListScreen.astro';

// Tiles that drift around the phone. The first three (data-fly) are the ones
// the intro sends into the list; the rest stay as ambient scenery.
const tiles = [
	{ icon: 'milk', fly: 'Milk', x: 17, y: 20, r: -8, s: 1 },
	{ icon: 'banana', fly: 'Bananas', x: 80, y: 16, r: 7, s: 1 },
	{ icon: 'cheese', fly: 'Cheese', x: 84, y: 58, r: -5, s: 1 },
	{ icon: 'avocado', x: 9, y: 54, r: 9, s: 0.85 },
	{ icon: 'coffee', x: 27, y: 74, r: -10, s: 0.75 },
	{ icon: 'strawberry', x: 69, y: 78, r: 8, s: 0.75 },
	{ icon: 'lemon', x: 3, y: 12, r: 6, s: 0.7 },
	{ icon: 'croissant', x: 94, y: 36, r: -9, s: 0.7 },
];
---

<section class="hero" data-hero aria-labelledby="hero-title">
	<div class="wrap copy">
		<h1 id="hero-title">Everyone you shop with, on one list.</h1>
		<p>
			Bagful is a shared shopping list that updates on every phone in the same second. Add milk at home and it's on
			your flatmate's screen before they reach the shop.
		</p>
	</div>

	<div class="stage">
		{
			tiles.map((t, i) => (
				<div
					class:list={['tile', { ambient: !t.fly }]}
					style={`left:${t.x}%;top:${t.y}%;--r:${t.r}deg;--s:${t.s};--d:${i * -0.9}s`}
					data-tile={t.fly}
					aria-hidden="true"
				>
					<img src={`/products/${t.icon}.svg`} alt="" width="96" height="96" />
				</div>
			))
		}
		<div class="phone-wrap">
			<Phone width="clamp(15rem, 28vw, 21rem)">
				<ListScreen hero />
			</Phone>
		</div>
	</div>
</section>

<script>
	import { playHero } from '../scripts/hero';
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) playHero(hero);
</script>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: var(--green-field);
		color: var(--on-green);
		padding-top: clamp(6.5rem, 14vh, 9rem);
		text-align: center;
	}
	.copy {
		position: relative;
		z-index: 2;
		display: grid;
		justify-items: center;
		gap: 1.5rem;
	}
	h1 {
		font-size: var(--step-4);
		max-width: 13ch;
		line-height: 0.95;
		letter-spacing: -0.05em;
	}
	.copy p {
		max-width: 34rem;
		font-size: var(--step-1);
		line-height: 1.45;
		font-weight: 500;
		color: var(--on-green);
	}

	.stage {
		position: relative;
		height: clamp(25rem, 46vw, 34rem);
		margin-top: clamp(1.5rem, 4vw, 3rem);
	}
	.phone-wrap {
		position: absolute;
		left: 50%;
		top: 0;
		translate: -50% 0;
		z-index: 1;
	}

	.tile {
		position: absolute;
		z-index: 2;
		width: calc(clamp(3.4rem, 7vw, 5.6rem) * var(--s));
		translate: -50% 0;
		rotate: var(--r);
	}
	.tile img {
		width: 100%;
		border-radius: 24%;
		box-shadow: 0 1rem 2rem -0.6rem rgb(8 40 22 / 0.45);
		animation: bob 7s ease-in-out infinite;
		animation-delay: var(--d);
	}
	@keyframes bob {
		50% {
			transform: translateY(-0.6rem);
		}
	}

	/* On a phone the ambient scenery would sit on top of the headline copy. */
	@media (max-width: 52rem) {
		.ambient {
			display: none;
		}
		.tile[data-tile='Milk'] {
			left: 12%;
			top: 8%;
		}
		.tile[data-tile='Bananas'] {
			left: 88%;
			top: 4%;
		}
		.tile[data-tile='Cheese'] {
			left: 88%;
			top: 52%;
		}
	}
</style>
