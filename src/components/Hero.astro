---
import Phone from './Phone.astro';
import ListScreen from './screens/ListScreen.astro';
import { site } from '../../config';

// The diagram, in a 1000 x 920 grid. Lines run at 0, 45 and 90 degrees only and
// run in under the phone's edge: the phone is the terminus every route is heading for. They
// tuck beneath it on purpose, because its width is snapped to whole pixels and so is a little
// narrower than the box it is laid out in.
const routes = [
	{ id: 'home', colour: 'var(--route-home)', d: 'M95 560 H170 L270 460 H340', who: 'Sam', at: [95, 560], item: 'Milk', icon: 'milk' },
	{ id: 'flat', colour: 'var(--route-flat)', d: 'M95 800 H170 L270 700 H340', who: 'Jo', at: [95, 800], item: 'Bananas', icon: 'banana' },
	{ id: 'parents', colour: 'var(--route-parents)', d: 'M965 380 H930 L870 440 H760', who: 'Mom', at: [965, 380], item: 'Cheese', icon: 'cheese' },
	{ id: 'trip', colour: 'var(--route-trip)', d: 'M960 640 H920 L860 700 H760', who: 'Alex', at: [960, 640], item: null, icon: null },
];
---

<section class="hero" data-hero aria-labelledby="hero-title">
	<div class="wrap grid">
		<div class="copy">
			<h1 id="hero-title">Everyone you shop with, on one list.</h1>
			<p>
				Bagful is a shared shopping list that updates on every phone in the same second. Add milk at home and it's on
				your flatmate's screen before they reach the shop.
			</p>
			<div class="actions">
				<a class="plaque" href={site.appUrl} rel="noopener">Open the web app</a>
				<a class="plaque line" href={site.downloadUrl} rel="noopener">Download the app</a>
			</div>
		</div>

		<div class="stage">
			<svg class="map" viewBox="0 0 1000 920" aria-hidden="true">
				<defs>
					<clipPath id="icon-clip"><rect x="-24" y="-24" width="48" height="48" rx="13"></rect></clipPath>
				</defs>
				<g class="routes" fill="none" stroke-width="22" stroke-linejoin="round">
					{routes.map((r) => <path class="route" id={`route-${r.id}`} d={r.d} stroke={r.colour}></path>)}
				</g>
				{
					routes.map((r) => (
						<g class="station" data-route={r.id} transform={`translate(${r.at[0]} ${r.at[1]})`}>
							<circle class="halo" r="26" fill={r.colour}></circle>
							<circle class="ring" r="24" fill="var(--ground)" stroke="var(--ink)" stroke-width="9"></circle>
							<text class="label" y="-42" text-anchor="middle">{r.who}</text>
						</g>
					))
				}
				{
					routes
						.filter((r) => r.item)
						.map((r) => (
							<g class="pulse" data-route={r.id} data-item={r.item} data-who={r.who}>
								<image href={`/products/${r.icon}.svg`} x="-24" y="-24" width="48" height="48" clip-path="url(#icon-clip)"></image>
							</g>
						))
				}
			</svg>
			<div class="phone-wrap">
				<Phone width="52cqw">
					<ListScreen hero />
				</Phone>
			</div>
		</div>
	</div>
</section>

<script>
	import { playHero } from '../scripts/hero';
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) playHero(hero);
</script>

<style>
	.hero {
		position: relative;
		overflow: clip;
		padding-top: 5.5rem;
	}
	.grid {
		display: grid;
		gap: 2rem;
	}
	.copy {
		display: grid;
		justify-items: start;
		align-content: center;
		gap: 1.4rem;
	}
	h1 {
		font-size: min(var(--step-4), 5.6rem);
		max-width: 11.5ch;
		line-height: 1;
	}
	.copy p {
		max-width: 31rem;
		font-size: var(--step-1);
		line-height: 1.4;
		font-weight: 500;
		color: var(--ink-soft);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.4rem;
	}

	.stage {
		margin-top: -14cqw;
		position: relative;
		container-type: inline-size;
		aspect-ratio: 1000 / 920;
		width: 100%;
	}
	.map {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.label {
		font-family: var(--display);
		font-size: 30px;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		fill: var(--ink);
	}
	.halo {
		opacity: 0;
	}
	.pulse {
		opacity: 0;
	}
	.phone-wrap {
		position: absolute;
		left: 30cqw;
		top: 25cqw;
		z-index: 1;
	}

	@media (min-width: 60rem) {
		.stage {
			margin-top: 0;
		}
		.hero {
			padding-top: 0;
		}
		.grid {
			grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
			align-items: end;
			column-gap: clamp(1rem, 3vw, 3rem);
			min-height: clamp(36rem, 92svh, 50rem);
		}
		.copy {
			align-self: center;
			padding-block: 6rem 3rem;
		}
	}
</style>
