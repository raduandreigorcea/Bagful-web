---
import Row from './screens/Row.astro';
import AppBar from './screens/AppBar.astro';

const chat = [
	{ who: 'Sam', text: 'milk?', side: 'in' },
	{ who: 'Alex', text: 'got milk', side: 'out' },
	{ who: 'Sam', text: 'omg I got milk too', side: 'in' },
	{ who: 'Jo', text: 'wait who has the list', side: 'in' },
	{ who: 'Alex', text: 'scroll up', side: 'out' },
	{ who: 'Sam', text: 'that’s now 3 jars of pickles', side: 'in' },
];
---

<section class="why stop" id="why" aria-labelledby="why-title" style="--route: var(--route-flat)">
	<div class="stop-body">
		<span class="rail-fill" data-rail></span>
		<div class="head">
			<span class="stop-ring" aria-hidden="true"></span>
			<h2 id="why-title">Group chats are terrible shopping lists.</h2>
		</div>
		<p class="lede">
			Messages scroll away, nobody knows what has already been bought, and the one time you don’t check, you come
			home with the third jar of pickles this week.
		</p>

		<div class="compare">
			<figure class="chat">
				<div class="chat-box" role="group" aria-label="Group chat about milk">
					<p class="chat-title">Group chat</p>
					{
						chat.map((m) => (
							<p class:list={['bubble', m.side]}>
								{m.side === 'in' && <b>{m.who}</b>}
								{m.text}
							</p>
						))
					}
				</div>
				<figcaption>A group chat: who has the list, and what is on it?</figcaption>
			</figure>

			<figure class="list">
				<div class="mini" aria-hidden="true">
					<AppBar label="3 items" percent={25} />
					<ul>
						<Row icon="milk" name="Milk" done />
						<Row icon="egg" name="Eggs" count={12} />
						<Row icon="bread" name="Bread" />
						<Row icon="pasta" name="Pasta" />
					</ul>
				</div>
				<figcaption>Bagful: one list, with everything already bought crossed off.</figcaption>
			</figure>
		</div>
	</div>
</section>

<style>
	.stop-body {
		padding-block: clamp(4rem, 9vw, 8rem);
	}
	.head {
		position: relative;
	}
	.stop-ring {
		left: -2.15rem;
		top: 0.5em;
	}
	h2 {
		font-size: var(--step-3);
		max-width: 17ch;
	}
	.lede {
		margin-top: 1.5rem;
		max-width: 38rem;
		font-size: var(--step-1);
		line-height: 1.4;
		font-weight: 500;
		color: var(--ink-soft);
	}
	.compare {
		margin-top: clamp(2.5rem, 6vw, 4.5rem);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: stretch;
	}
	figure {
		margin: 0;
		display: grid;
		grid-template-rows: 1fr auto;
		gap: 1.1rem;
	}
	figcaption {
		font-weight: 700;
		color: var(--ink-soft);
		font-size: var(--step--1);
	}

	/* The chat is off the grid on purpose: bubbles at odd angles, no line through them. */
	.chat-box {
		display: grid;
		gap: 0.55rem;
		padding: 1.4rem;
		border-radius: 0.9rem;
		background: var(--ground-deep);
		min-height: 24rem;
		align-content: start;
		font-family: var(--font);
	}
	.chat-title {
		font-weight: 800;
		margin-bottom: 0.4rem;
	}
	.bubble {
		max-width: 80%;
		padding: 0.6rem 0.95rem;
		border-radius: 1.15rem;
		background: #fff;
		font-size: var(--step--1);
		line-height: 1.35;
	}
	.bubble b {
		display: block;
		font-size: 0.78em;
		color: var(--green-deep);
	}
	.bubble.out {
		justify-self: end;
		background: var(--leaf);
	}
	.bubble:nth-child(odd) {
		rotate: -1.2deg;
	}
	.bubble:nth-child(even) {
		rotate: 1deg;
	}

	/* The list card is a slice of the real app: its green bar over the paper list. */
	.mini {
		min-height: 24rem;
		border-radius: 0.9rem;
		overflow: hidden;
		background: var(--paper);
		box-shadow: 0 0 0 2px var(--ink);
		font-size: 13px;
		font-family: var(--font);
		line-height: 1.25;
		color: var(--text);
	}
	.mini :global(.ui-top) {
		padding-top: 0.75em;
	}
	.mini :global(.ui-status) {
		display: none;
	}
	.mini ul {
		list-style: none;
		margin: 0;
		padding: 0.4em 0.6em;
	}

	@media (max-width: 48rem) {
		.compare {
			grid-template-columns: 1fr;
		}
		.chat-box,
		.mini {
			min-height: 0;
		}
	}
</style>
