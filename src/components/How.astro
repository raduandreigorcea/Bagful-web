---
import Phone from './Phone.astro';
import ListScreen from './screens/ListScreen.astro';
import CheckoutScreen from './screens/CheckoutScreen.astro';
import OfflineScreen from './screens/OfflineScreen.astro';
import PushScreen from './screens/PushScreen.astro';

const steps = [
	{
		title: 'Add it once. Everyone sees it.',
		text: 'Start a list, share a short invite code, and you are in the same list. Whatever anyone adds or ticks off shows up on every screen at once. No refresh, no “did you see my message?”.',
		Screen: ListScreen,
	},
	{
		title: 'Tick it in the shop, then slide to buy.',
		text: 'Check items off as you find them. When the trolley is done, slide to confirm. Bought items move into a history grouped by trip, so “didn’t we just buy this?” always has an answer.',
		Screen: CheckoutScreen,
	},
	{
		title: 'No signal? Keep shopping.',
		text: 'Basement supermarkets happen. Keep adding and ticking items offline, and everything catches up the moment you are back online.',
		Screen: OfflineScreen,
	},
	{
		title: 'A nudge only when it matters.',
		text: 'You hear when someone adds something or finishes shopping, even with the app closed. Never while you are looking at it, and easy to switch off completely.',
		Screen: PushScreen,
	},
];
---

<section class="how" id="how" aria-labelledby="how-title">
	<div class="wrap">
		<h2 id="how-title">How it works</h2>
	</div>

	<div class="wrap grid" data-steps>
		<div class="stage-col">
			<div class="stage" data-stage data-active="0">
				<Phone width="clamp(15rem, 24vw, 19.5rem)">
					{
						steps.map(({ Screen }, i) => (
							<div class="screen" data-screen={i} class:list={{ 'is-live': i === 0 }}>
								<Screen />
							</div>
						))
					}
				</Phone>
			</div>
		</div>

		{
			steps.map((s, i) => (
				<article class="step" data-step={i} class:list={{ left: i % 2 === 0, right: i % 2 === 1 }}>
					<div class="step-copy">
						<h3>{s.title}</h3>
						<p>{s.text}</p>
					</div>
					<div class="step-phone">
						<Phone width="min(17rem, 72vw)">
							<s.Screen />
						</Phone>
					</div>
				</article>
			))
		}
	</div>
</section>

<script>
	import { watchSteps } from '../scripts/steps';
	watchSteps();
</script>

<style>
	.how {
		padding-block: clamp(4rem, 9vw, 8rem) clamp(2rem, 5vw, 4rem);
	}
	h2 {
		font-size: var(--step-3);
		max-width: 14ch;
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr minmax(15rem, 19.5rem) 1fr;
		column-gap: clamp(2rem, 6vw, 6rem);
		margin-top: 1rem;
	}
	.stage-col {
		grid-column: 2;
		grid-row: 1 / span 4;
	}
	.stage {
		position: sticky;
		top: max(5rem, calc(50vh - 20rem));
	}
	.screen {
		position: absolute;
		inset: 0;
		opacity: 0;
		scale: 0.96;
		transition:
			opacity 0.5s var(--ease),
			scale 0.6s var(--ease);
	}
	.screen:first-child {
		/* No-JS fallback: the first screen is visible until the script takes over. */
		opacity: 1;
		scale: 1;
	}
	.stage[data-active] .screen {
		opacity: 0;
		scale: 0.96;
	}
	.stage[data-active='0'] .screen[data-screen='0'],
	.stage[data-active='1'] .screen[data-screen='1'],
	.stage[data-active='2'] .screen[data-screen='2'],
	.stage[data-active='3'] .screen[data-screen='3'] {
		opacity: 1;
		scale: 1;
	}

	.step {
		min-height: 88vh;
		display: flex;
		align-items: center;
		opacity: 0.35;
		transition: opacity 0.4s var(--ease);
	}
	.step.is-active {
		opacity: 1;
	}
	.step.left {
		grid-column: 1;
	}
	.step.right {
		grid-column: 3;
	}
	.step:nth-of-type(1) {
		grid-row: 1;
	}
	.step:nth-of-type(2) {
		grid-row: 2;
	}
	.step:nth-of-type(3) {
		grid-row: 3;
	}
	.step:nth-of-type(4) {
		grid-row: 4;
	}
	.step-copy {
		max-width: 26rem;
		display: grid;
		gap: 1rem;
	}
	.step.right .step-copy {
		margin-left: 0;
	}
	.step.left .step-copy {
		margin-left: auto;
	}
	h3 {
		font-size: var(--step-2);
	}
	.step p {
		color: var(--text-soft);
	}
	.step-phone {
		display: none;
	}

	/* Narrow screens: no sticky stage; every step brings its own phone. */
	@media (max-width: 60rem) {
		.grid {
			display: block;
		}
		.stage-col {
			display: none;
		}
		.step {
			display: grid;
			gap: 2rem;
			min-height: 0;
			opacity: 1;
			padding-block: 3rem;
			justify-items: center;
		}
		.step-copy {
			max-width: 34rem;
		}
		.step-phone {
			display: block;
		}
	}
</style>
