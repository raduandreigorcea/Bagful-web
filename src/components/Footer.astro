---
import { site } from '../../config';
const year = new Date().getFullYear();
---

<footer>
	<div class="wrap row">
		<p class="brand">
			<img src="/icons/pwa-192.png" alt="" width="32" height="32" />
			<span>Bagful</span>
		</p>
		<nav aria-label="Legal and source">
			<a href="/privacy">Privacy</a>
			<a href="/terms">Terms</a>
			<a href={site.repoUrl} rel="noopener">Source on GitHub</a>
		</nav>
		<p class="fine">© {year} Bagful. Source-available under the PolyForm Noncommercial License.</p>
	</div>
</footer>

<style>
	footer {
		background: var(--green-ink);
		color: var(--cream);
		padding-block: 3rem;
	}
	.row {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: 1fr auto;
		align-items: center;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 800;
		font-size: 1.2rem;
		letter-spacing: -0.03em;
	}
	.brand img {
		border-radius: 9px;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		font-weight: 600;
		font-size: var(--step--1);
	}
	.fine {
		grid-column: 1 / -1;
		font-size: var(--step--1);
		color: color-mix(in srgb, var(--cream) 70%, transparent);
	}
	@media (max-width: 40rem) {
		.row {
			grid-template-columns: 1fr;
		}
	}
</style>
