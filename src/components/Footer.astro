---
import { site } from '../../config';
const year = new Date().getFullYear();
---

<footer>
	<div class="wrap">
		<div class="row">
			<p class="brand">
				<img src="/icons/pwa-192.png" alt="" width="32" height="32" />
				<span>Bagful</span>
			</p>
			<nav aria-label="Legal and source">
				<a href="/privacy">Privacy</a>
				<a href="/terms">Terms</a>
				<a href={site.repoUrl} rel="noopener">Source on GitHub</a>
			</nav>
		</div>
		<p class="fine">© {year} Bagful. Source-available under the PolyForm Noncommercial License.</p>
	</div>
</footer>

<style>
	footer {
		background: var(--ink);
		color: var(--ground);
		padding-block: 2.5rem 3rem;
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem 2rem;
		align-items: center;
		justify-content: space-between;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 800;
		font-size: 1.25rem;
		letter-spacing: -0.04em;
	}
	.brand img {
		border-radius: 9px;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		font-weight: 700;
		font-size: var(--step--1);
	}
	.fine {
		margin-top: 1.5rem;
		font-size: var(--step--1);
		color: color-mix(in srgb, var(--ground) 72%, transparent);
	}
</style>
