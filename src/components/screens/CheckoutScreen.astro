---
import AppBar from './AppBar.astro';
import NavBar from './NavBar.astro';
import Row from './Row.astro';
---

<div class="ui-screen">
	<AppBar time="10:12" label="2 items" percent={60} />
	<ul class="ui-list">
		<Row icon="egg" name="Eggs" count={12} done />
		<Row icon="bread" name="Bread" done />
		<Row icon="milk" name="Milk" count={2} done />
		<Row icon="tomato" name="Tomatoes" />
		<Row icon="cheese" name="Cheese" />
	</ul>
	<div class="ui-buy">
		<div class="ui-track">
			<span class="ui-fill"></span>
			<span class="ui-slide-label">Slide to check out 3 items</span>
			<span class="ui-slide-label ui-slide-label--inverse" aria-hidden="true">Slide to check out 3 items</span>
		</div>
		<span class="ui-knob">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
			<svg class="ui-knob-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
		</span>
	</div>
	<NavBar />
</div>

<style is:global>
	/* The app’s buy bar: a 56px thumb standing 1.5px proud of a thinner white
	   track, a green label centred in it, and a green trail behind the thumb. */
	.ui-buy {
		position: relative;
		container-type: inline-size;
		margin: 0.4em 0.85em 1.7em;
		height: 3.5em;
	}
	.ui-track {
		position: absolute;
		inset: 0.09em;
		border-radius: 999px;
		background: #fff;
		border: 0.07em solid #e5e0d9;
		box-shadow: 0 0.2em 0.8em rgb(15 23 42 / 0.07);
		overflow: hidden;
		display: grid;
		place-items: center;
	}
	.ui-fill {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 0;
		border-radius: 999px;
		background: color-mix(in srgb, var(--green) 80%, #fff);
	}
	.ui-slide-label {
		grid-area: 1 / 1;
		position: relative;
		padding: 0 3.4em;
		font-size: 0.9em;
		font-weight: 800;
		letter-spacing: -0.01em;
		white-space: nowrap;
		color: var(--green);
	}
	.ui-slide-label--inverse {
		color: #fff;
		clip-path: inset(0 100% 0 0);
	}
	.ui-knob {
		position: absolute;
		left: 0;
		top: 0;
		display: grid;
		place-items: center;
		width: 3.5em;
		height: 3.5em;
		border-radius: 50%;
		background: var(--green);
		color: #fff;
		box-shadow: 0 0.25em 0.75em rgb(77 140 101 / 0.28);
	}
	.ui-knob svg {
		grid-area: 1 / 1;
		width: 1.35em;
		height: 1.35em;
	}
	.ui-knob-tick {
		opacity: 0;
	}
	.is-live .ui-knob svg:first-child {
		animation: ui-cart 0.3s 2.6s both;
	}
	.is-live .ui-knob-tick {
		animation: ui-tick 0.4s 2.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
	}
	@keyframes ui-cart {
		to {
			opacity: 0;
			scale: 0.4;
		}
	}
	@keyframes ui-tick {
		from {
			opacity: 0;
			scale: 0.4;
		}
		to {
			opacity: 1;
			scale: 1;
		}
	}
	.is-live .ui-knob {
		animation: ui-knob 2.2s 0.6s var(--ease) both;
	}
	.is-live .ui-fill {
		animation: ui-fill 2.2s 0.6s var(--ease) both;
	}
	.is-live .ui-slide-label--inverse {
		animation: ui-ink 2.2s 0.6s var(--ease) both;
	}
	@keyframes ui-knob {
		to {
			translate: calc(100cqw - 3.5em) 0;
		}
	}
	@keyframes ui-fill {
		to {
			width: calc(100cqw - 0.18em);
		}
	}
	@keyframes ui-ink {
		to {
			clip-path: inset(0 0 0 0);
		}
	}
</style>
