---
interface Props {
	icon: string;
	name: string;
	/** Quantity: "1" draws the quiet pill, anything else "x{n}". */
	count?: number;
	done?: boolean;
	/** Rows the hero adds with a script; the HTML ships them so no-JS shows the finished list. */
	late?: boolean;
}
const { icon, name, count = 1, done = false, late = false } = Astro.props;
---

<li class:list={['ui-row', { 'is-done': done }]} data-late={late ? '' : undefined} data-name={name}>
	<div class="ui-row-in">
		<div class="ui-item">
			<span class="ui-icon">
				<img src={`/products/${icon}.svg`} alt="" width="64" height="64" />
				<span class="ui-tick">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
				</span>
			</span>
			<span class="ui-item-name">{name}</span>
			<span class:list={['ui-qty', { one: count === 1 }]}>{count === 1 ? '1' : `x${count}`}</span>
		</div>
	</div>
</li>
