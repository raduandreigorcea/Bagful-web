---
import AppBar from './AppBar.astro';
import NavBar from './NavBar.astro';
import Row from './Row.astro';
---

<div class="ui-screen">
	<AppBar time="17:56" signal="No signal" label="2 items" percent={50}>
		<span class="ui-offline">Offline</span>
	</AppBar>
	<p class="ui-banner">You're offline. Everything you do now syncs when the signal is back.</p>
	<ul class="ui-list">
		<Row icon="olive-oil" name="Olive oil" />
		<Row icon="pasta" name="Pasta" count={2} done />
		<Row icon="tomato" name="Tomatoes" done />
		<Row icon="cheese" name="Cheese" />
	</ul>
	<NavBar />
</div>

<style is:global>
	.ui-offline {
		padding: 0.35em 0.8em;
		border-radius: 999px;
		background: var(--honey);
		color: var(--green-ink);
		font-size: 0.8em;
		font-weight: 800;
	}
	.ui-banner {
		margin: 0.8em 0.8em 0;
		padding: 0.7em 0.9em;
		border-radius: 0.9em;
		background: #fbeccd;
		color: #6b4a12;
		font-size: 0.84em;
		font-weight: 600;
	}
</style>
