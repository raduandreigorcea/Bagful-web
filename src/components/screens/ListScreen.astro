---
import AppBar from './AppBar.astro';
import NavBar from './NavBar.astro';
import Row from './Row.astro';

interface Props {
	/** The hero version carries hooks for the intro animation. */
	hero?: boolean;
}
const { hero = false } = Astro.props;
---

<div class="ui-screen" data-hero-screen={hero ? '' : undefined}>
	<AppBar label="5 items" percent={17} />
	<ul class="ui-list" data-list={hero ? '' : undefined}>
		<Row icon="cheese" name="Cheese" late={hero} />
		<Row icon="banana" name="Bananas" count={6} late={hero} />
		<Row icon="milk" name="Milk" count={2} late={hero} />
		<Row icon="egg" name="Eggs" count={12} />
		<Row icon="bread" name="Bread" />
		<Row icon="tomato" name="Tomatoes" done />
	</ul>
	<NavBar />
	{
		hero && (
			<div class="ui-toast" data-toast>
				<img src="/products/milk.svg" alt="" width="32" height="32" />
				<span data-toast-text>Sam added Milk</span>
			</div>
		)
	}
</div>
