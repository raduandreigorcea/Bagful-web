---
import Row from './Row.astro';

interface Props {
	/** The hero version carries hooks for the intro animation. */
	hero?: boolean;
}
const { hero = false } = Astro.props;
---

<div class="ui-screen" data-hero-screen={hero ? '' : undefined}>
	<div class="ui-top">
		<span class="ui-status"><span>9:41</span><span>5G</span></span>
		<div class="ui-top-row">
			<div>
				<h4>Home</h4>
				<small>3 people shopping</small>
			</div>
			<div class="ui-avatars">
				<span style="background:#edbe6e">R</span>
				<span style="background:#9ccf84">A</span>
				<span style="background:#f59c7e">M</span>
			</div>
		</div>
	</div>
	<ul class="ui-list" data-list={hero ? '' : undefined}>
		<Row icon="cheese" name="Cheese" qty="200 g" late={hero} />
		<Row icon="banana" name="Bananas" qty="6" late={hero} />
		<Row icon="milk" name="Milk" qty="2" late={hero} />
		<Row icon="egg" name="Eggs" qty="12" />
		<Row icon="bread" name="Bread" />
		<Row icon="tomato" name="Tomatoes" qty="1 kg" />
	</ul>
	<div class="ui-add">
		<span class="ui-add-field">Add an item</span>
		<span class="ui-add-disc">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
		</span>
	</div>
	{
		hero && (
			<div class="ui-toast" data-toast>
				<img src="/products/milk.svg" alt="" width="32" height="32" />
				<span data-toast-text>Radu added Milk</span>
			</div>
		)
	}
</div>
