---
// The map key: the small things the README lists, each with a real product icon
// from the app and the route colour it rides on.
const facts = [
	{ icon: 'apple', title: 'Join with a short code', text: 'Share an invite code and you are in. The list owner decides who can manage the list and its members.', route: 'var(--route-home)' },
	{ icon: 'banana', title: 'Duplicates merge', text: 'Add eggs twice and you get one item with a higher quantity, not two lines to compare.', route: 'var(--route-flat)' },
	{ icon: 'avocado', title: 'Every item gets its own icon', text: 'Products get a fitting picture automatically, so a list reads at a glance in the aisle.', route: 'var(--route-parents)' },
	{ icon: 'cherry', title: 'Install it, or just open it', text: 'Works in any browser, installs to your home screen like a real app, and ships as a native Android app too.', route: 'var(--route-trip)' },
];
---

<section class="details stop" aria-labelledby="details-title" style="--route: var(--route-parents)">
	<div class="stop-body">
		<span class="rail-fill" data-rail></span>
		<div class="head">
			<span class="stop-ring" aria-hidden="true"></span>
			<h2 id="details-title">Small things that add up.</h2>
		</div>
		<ul class="facts">
			{
				facts.map((f) => (
					<li style={`--c:${f.route}`}>
						<span class="stub" aria-hidden="true"></span>
						<img src={`/products/${f.icon}.svg`} alt="" width="64" height="64" loading="lazy" />
						<h3>{f.title}</h3>
						<p>{f.text}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.stop-body {
		padding-block: clamp(4rem, 8vw, 7rem);
	}
	.head {
		position: relative;
	}
	.stop-ring {
		left: -2.15rem;
		top: 0.5em;
	}
	h2 {
		font-size: var(--step-3);
		max-width: 12ch;
	}
	.facts {
		list-style: none;
		margin: clamp(2rem, 5vw, 3.5rem) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 4rem);
	}
	.facts li {
		display: grid;
		grid-template-columns: 4rem 1fr;
		column-gap: 1.2rem;
		row-gap: 0.4rem;
		align-content: start;
	}
	/* Each fact hangs from a short stub of its own route colour. */
	.stub {
		grid-column: 1 / -1;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--c);
		margin-bottom: 1rem;
	}
	.facts img {
		grid-row: 2 / span 2;
		width: 4rem;
		height: 4rem;
		border-radius: 1.1rem;
	}
	h3 {
		font-size: var(--step-1);
		letter-spacing: -0.03em;
		align-self: end;
	}
	.facts p {
		color: var(--ink-soft);
		font-weight: 500;
		max-width: 28rem;
	}
	@media (max-width: 48rem) {
		.facts {
			grid-template-columns: 1fr;
		}
	}
</style>
