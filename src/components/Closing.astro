		box-shadow: 0 1.2rem 2.4rem -0.8rem rgb(8 40 22 / 0.5);
		rotate: -4deg;
	}
	h2 {
		font-size: var(--step-3);
		max-width: 16ch;
	}
	p {
		font-size: var(--step-1);
		font-weight: 500;
		max-width: 30rem;
		color: var(--on-green);
